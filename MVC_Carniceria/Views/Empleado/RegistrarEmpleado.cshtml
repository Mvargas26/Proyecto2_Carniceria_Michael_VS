@using MVC_Carniceria.Models
@model EmpleadoViewModel

@{
    ViewData["Title"] = "Registrar Empleado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Empleado/registrarEmpleado.css" asp-append-version="true" />
}

<div class="form-page">

    <div class="form-header">
        <h1>Registrar Empleado</h1>
        <p>Complete la información para registrar una nueva persona empleada en el sistema.</p>
    </div>

    <div class="form-card">
        <form asp-action="RegistrarEmpleado" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="TipoIdentificacion" class="form-label">Tipo de Identificación</label>
                    <select asp-for="TipoIdentificacion" class="form-select" asp-items="ViewBag.ListaTiposIdentificacion">
                        <option value=""> Seleccione un tipo </option>
                    </select>
                    <span asp-validation-for="TipoIdentificacion" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Identificacion" class="form-label">Identificación</label>
                    <input asp-for="Identificacion" class="form-control" placeholder="Ej. 1-1111-1111" />
                    <span asp-validation-for="Identificacion" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Nombre" class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PrimerApellido" class="form-label">Primer Apellido</label>
                    <input asp-for="PrimerApellido" class="form-control" />
                    <span asp-validation-for="PrimerApellido" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="SegundoApellido" class="form-label">Segundo Apellido</label>
                    <input asp-for="SegundoApellido" class="form-control" />
                    <span asp-validation-for="SegundoApellido" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaNacimiento" class="form-label">Fecha de Nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaIngreso" class="form-label">Fecha de Ingreso</label>
                    <input asp-for="FechaIngreso" type="date" class="form-control" />
                    <span asp-validation-for="FechaIngreso" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="SalarioMensual" class="form-label">Salario Mensual</label>
                    <input asp-for="SalarioMensual" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="SalarioMensual" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AreaTrabajo" class="form-label">Área de Trabajo</label>
                    <select asp-for="AreaTrabajo" class="form-select" id="selectArea" asp-items="ViewBag.ListaAreasTrabajo">
                        <option value=""> Seleccione un área </option>
                    </select>
                    <span asp-validation-for="AreaTrabajo" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Puesto" class="form-label">Puesto</label>
                    <select asp-for="Puesto" class="form-select" id="selectPuesto" asp-items="ViewBag.ListaPuestos">
                        <option value=""> Seleccione un puesto </option>
                    </select>
                    <span asp-validation-for="Puesto" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Turno" class="form-label">Turno</label>
                    <select asp-for="Turno" class="form-select" asp-items="ViewBag.ListaTurnos">
                        <option value=""> Seleccione un turno </option>
                    </select>
                    <span asp-validation-for="Turno" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="ListarEmpleados" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Registrar</button>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const mapeoAreaPuesto = @Html.Raw(ViewBag.MapeoAreaPuesto);
    </script>
    <script src="~/js/Empleados/registrarEmpleado.js" asp-append-version="true"></script>
}