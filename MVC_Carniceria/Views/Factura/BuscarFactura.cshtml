@using MVC_Carniceria.Models
@model IEnumerable<MVC_Carniceria.Models.FacturaViewModel>

@{
    ViewData["Title"] = "Buscar Factura";
    var metodosPago = ViewBag.MetodosPago as Dictionary<int, string>;
    var estadosFactura = ViewBag.EstadosFactura as Dictionary<int, string>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Factura/RegistrarFactura.css" asp-append-version="true" />
}

<div class="form-page">

    <div class="form-header">
        <h1>Buscar Factura</h1>
        <p>Ingrese el número de factura o la identificación de la persona cliente que desea consultar.</p>
    </div>

    @if (ViewBag.MensajeInformativo != null)
    {
        <div class="alert alert-info">@ViewBag.MensajeInformativo</div>
    }

    <div class="form-card">
        <form asp-action="BuscarFactura" method="post">
            <div class="row g-3">

                <div class="col-12">
                    <label class="form-label d-block">Buscar por</label>
                    <div class="form-check form-check-inline">
                        <input type="radio" name="criterio" value="NumeroFactura" class="form-check-input" id="criterioNumero" checked />
                        <label class="form-check-label" for="criterioNumero">Número de Factura</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input type="radio" name="criterio" value="Identificacion" class="form-check-input" id="criterioIdentificacion" />
                        <label class="form-check-label" for="criterioIdentificacion">Identificación del Cliente</label>
                    </div>
                </div>

                <div class="col-md-8">
                    <label for="texto" class="form-label">Texto a buscar</label>
                    <input type="text" name="texto" id="texto" class="form-control" placeholder="Ej: FAC-0001 o 1-1111-1111" required />
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="ListarFacturas" class="btn btn-secondary">Volver</a>
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var factura in Model)
        {
            // Obtenemos el nombre del método de pago, si no queda n/a
            string nombreMetodo = "N/A";
            if (metodosPago != null && factura.MetodoPago.HasValue && metodosPago.ContainsKey(factura.MetodoPago.Value))
            {
                nombreMetodo = metodosPago[factura.MetodoPago.Value];
            }

            // 2. Obtenemos el nombre del estado
            string nombreEstado = "N/A";
            if (estadosFactura != null && estadosFactura.ContainsKey(factura.Estado))
            {
                nombreEstado = estadosFactura[factura.Estado];
            }

            // Da color de la etiqueta según el estado
            string claseBadge = "bg-secondary"; // gris por defecto
                
            if (factura.Estado == 1)
                {
                    claseBadge = "bg-warning text-dark"; // Amarillo Pendiente
                }
                else if (factura.Estado == 2)
                {
                    claseBadge = "bg-success";           // Verde Pagada
                }
                else if (factura.Estado == 3)
                {
                    claseBadge = "bg-danger";            // Rojo Anulada
                }

            <div class="form-card mt-4">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                    <h3 >Factura: <strong>@factura.NumeroFactura</strong></h3>
                    <span class="badge @claseBadge fs-6">@nombreEstado</span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Fecha y Hora de Emisión:</strong> @factura.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</p>
                        <p class="mb-1"><strong>Cliente:</strong> @factura.NombreCliente (@factura.IdentificacionCliente)</p>
                        <p class="mb-1"><strong>Empleado Responsable:</strong> @factura.NombreEmpleado</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Método de Pago:</strong> @nombreMetodo</p>
                        <p class="mb-1"><strong>Descuento Aplicado:</strong> @factura.PorcentajeDescuento.ToString("0.##")%</p>
                    </div>
                </div>

                <h4 class="mt-3 mb-2">Detalle de Productos Vendidos</h4>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th>Unidad de Medida</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Precio Unitario</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (factura.Detalles != null && factura.Detalles.Any())
                            {
                                @foreach (var det in factura.Detalles)
                                {
                                    <tr>
                                        <td>@det.CodigoProducto</td>
                                        <td>@det.NombreProducto</td>
                                        <td> @det.UnidadMedida.ToString()</td>
                                        <td class="text-end">@det.Cantidad.ToString("N2")</td>
                                        <td class="text-end">₡@det.PrecioUnitario.ToString("N2")</td>
                                        <td class="text-end">₡@det.Subtotal.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No hay líneas de detalle registradas.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-3">
                    <div class="col-md-5">
                        <ul class="list-group list-group-flush border rounded">
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Subtotal:</span>
                                <strong>₡@factura.Subtotal.ToString("N2")</strong>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Descuento (@factura.PorcentajeDescuento.ToString("0.##")%):</span>
                                <span class="text-danger">- ₡@factura.MontoDescuento.ToString("N2")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>Base Gravable:</span>
                                <span>₡@factura.BaseGravable.ToString("N2")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span>IVA (13%):</span>
                                <span>₡@factura.Impuesto.ToString("N2")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between bg-light">
                                <span class="fs-5"><strong>Total:</strong></span>
                                <span class="fs-5 text-success"><strong>₡@factura.Total.ToString("N2")</strong></span>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    @if (factura.Estado == 1)
                    {
                        <form asp-action="PagarFactura" asp-route-id="@factura.Id" method="post"
                              onsubmit="return confirm('¿Está seguro de que desea procesar el PAGO de la factura @factura.NumeroFactura? Esta acción descontará las cantidades vendidas de las existencias del inventario.');"
                              style="display:inline;">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-cash-coin me-1"></i> Pagar Factura
                            </button>
                        </form>

                        <a asp-action="EditarFactura" asp-route-id="@factura.Id" class="btn btn-secondary">
                            <i class="bi bi-pencil me-1"></i> Editar
                        </a>

                        <form asp-action="EliminarFactura" asp-route-id="@factura.Id" method="post"
                              onsubmit="return confirm('¿Está seguro de que desea ELIMINAR físicamente la factura @factura.NumeroFactura? Esta acción no se puede deshacer.');"
                              style="display:inline;">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i> Eliminar
                            </button>
                        </form>
                    }
                    else if (factura.Estado == 2)
                    {
                        <form asp-action="AnularFactura" asp-route-id="@factura.Id" method="post"
                              onsubmit="return confirm('¿Está seguro de que desea ANULAR la factura @factura.NumeroFactura? Esta acción reintegrará las existencias previamente rebajadas al inventario de una sola vez.');"
                              style="display:inline;">
                            <button type="submit" class="btn btn-warning text-dark">
                                <i class="bi bi-x-circle me-1"></i> Anular Factura
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-secondary p-2">Factura Anulada (No admite modificaciones)</span>
                    }
                </div>
            </div>
        }
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}