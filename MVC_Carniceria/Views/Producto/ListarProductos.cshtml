@using MVC_Carniceria.Models
@model List<ProductoViewModel>

@{
    ViewData["Title"] = "Productos";

    var categorias = (Dictionary<int, string>)ViewBag.Categorias;
    var unidadesMedida = (Dictionary<int, string>)ViewBag.UnidadesMedida;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Producto/listarProducto.css" asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1>Productos</h1>
        <p>Listado del inventario de productos registrados en el sistema.</p>
        <br />
        <a asp-action="RegistrarProducto" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Registrar Producto
        </a>
    </div>

    <a asp-action="BuscarProducto" class="btn btn-secondary">
        <i class="bi bi-search"></i> Buscar Producto
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-basket"></i>
        <h3>No hay productos registrados</h3>
        <p>Comienza registrando el primer producto.</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Unidad de Medida</th>
                    <th>Precio</th>
                    <th>Existencia Actual</th>
                    <th>Existencia Mínima</th>
                    <th>Proveedor Principal</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr class="@(producto.RequiereReabastecimiento ? "fila-advertencia" : "")">
                        <td>@producto.CodigoProducto</td>
                        <td>@producto.NombreProducto</td>
                        <td>@(producto.Categoria.HasValue && categorias != null && categorias.ContainsKey(producto.Categoria.Value) ? categorias[producto.Categoria.Value] : "-")</td>
                        <td>@(producto.UnidadMedida.HasValue && unidadesMedida != null && unidadesMedida.ContainsKey(producto.UnidadMedida.Value) ? unidadesMedida[producto.UnidadMedida.Value] : "-")</td>
                        <td>@(producto.PrecioPorUnidadMedida.HasValue ? producto.PrecioPorUnidadMedida.Value.ToString("C2") : "-")</td>
                        <td>
                            @producto.ExistenciaActual
                            @if (producto.RequiereReabastecimiento)
                            {
                                <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="Existencia baja (requiere reabastecimiento)"></i>
                            }
                        </td>
                        <td>@producto.ExistenciaMinima</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(producto.RazonSocialProveedor ?? "No asignado")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="EditarProducto" asp-route-id="@producto.Id" class="btn btn-sm btn-icon btn-edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="EliminarProducto" asp-route-id="@producto.Id" method="post"
                                  onsubmit="return confirm('¿Está seguro que desea eliminar el producto @producto.NombreProducto?');"
                                  style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-icon btn-delete" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}