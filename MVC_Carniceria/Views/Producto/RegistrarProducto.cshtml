@using MVC_Carniceria.Models
@model ProductoViewModel

@{
    ViewData["Title"] = "Registrar Producto";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Producto/registrarProducto.css" asp-append-version="true" />
}

<div class="form-page">

    <div class="form-header">
        <h1>Registrar Producto</h1>
        <p>Complete la información para agregar un nuevo producto al inventario.</p>
    </div>

    <div class="form-card">
        <form asp-action="RegistrarProducto" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="CodigoProducto" class="form-label">Código del Producto</label>
                    <input asp-for="CodigoProducto" class="form-control" />
                    <span asp-validation-for="CodigoProducto" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NombreProducto" class="form-label">Nombre del Producto</label>
                    <input asp-for="NombreProducto" class="form-control" />
                    <span asp-validation-for="NombreProducto" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Categoria" class="form-label">Categoría</label>
                    <select asp-for="Categoria" class="form-select" asp-items="ViewBag.Categorias">
                        <option value="">-- Seleccione una categoría --</option>
                    </select>
                    <span asp-validation-for="Categoria" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="UnidadMedida" class="form-label">Unidad de Medida</label>
                    <select asp-for="UnidadMedida" class="form-select" asp-items="ViewBag.UnidadesMedida">
                        <option value="">-- Seleccione una unidad --</option>
                    </select>
                    <span asp-validation-for="UnidadMedida" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ProveedorId" class="form-label">Proveedor Principal</label>
                    <select asp-for="ProveedorId" class="form-select" asp-items="ViewBag.Proveedores">
                        <option value="">-- Seleccione un proveedor --</option>
                    </select>
                    <span asp-validation-for="ProveedorId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="PrecioPorUnidadMedida" class="form-label">Precio (₡)</label>
                    <input asp-for="PrecioPorUnidadMedida" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="PrecioPorUnidadMedida" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ExistenciaActual" class="form-label">Existencia Actual</label>
                    <input asp-for="ExistenciaActual" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="ExistenciaActual" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ExistenciaMinima" class="form-label">Existencia Mínima</label>
                    <input asp-for="ExistenciaMinima" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="ExistenciaMinima" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="ListarProductos" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Registrar</button>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}